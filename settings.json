{
  // ═══════════════════════════════════════════════════════════════
  //  GITHUB COPILOT — PERFECT SETUP SETTINGS
  //  Stack: .NET · Angular · React · Azure
  //  Shared by: https://www.youtube.com/@AIWithSandeep
  //  Place this file at: .vscode/settings.json in your repo root
  //  OR copy to: File → Preferences → Settings (JSON) for global
  // ═══════════════════════════════════════════════════════════════

  // ─── CORE COPILOT TOGGLES ──────────────────────────────────────

  // Enable Copilot per language (false = disabled for that language)
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "json": true,
    "jsonc": true,
    "csharp": true,
    "typescript": true,
    "typescriptreact": true,
    "javascript": true,
    "javascriptreact": true,
    "html": true,
    "css": true,
    "scss": true,
    "bicep": true,
    "terraform": true,
    "dockerfile": true,
    "xml": false
  },

  // Enable next-edit suggestions (Copilot predicts your next change)
  "github.copilot.nextEditSuggestions.enabled": true,

  // Always show inline completions automatically
  "github.copilot.editor.enableAutoCompletions": true,

  // ─── COPILOT CHAT ──────────────────────────────────────────────

  // Use your .github/copilot-instructions.md automatically in every chat
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // Show follow-up suggestions after every chat response
  "github.copilot.chat.followUps": "always",

  // Lock Copilot Chat responses to English (consistent for a multilingual team)
  "github.copilot.chat.localeOverride": "en",

  // Automatically trigger rename suggestions from Copilot
  "github.copilot.renameSuggestions.triggerAutomatically": true,

  // Use project-level templates when generating code
  "github.copilot.chat.useProjectTemplates": true,

  // Enable Copilot to suggest fixes for terminal errors
  "github.copilot.chat.terminalChatLocation": "chatView",

  // ─── INLINE INSTRUCTIONS (per task type) ───────────────────────
  // These instructions guide Copilot for specific /commands

  "github.copilot.chat.codeGeneration.instructions": [
    {
      "text": "Always follow Clean Architecture for .NET. Use async/await for all I/O. Return ActionResult<T> from controllers. Use FluentValidation for validation. Apply Repository + Unit of Work patterns."
    },
    {
      "text": "For Angular: use standalone components, OnPush change detection, inject() function, and Angular Signals. No NgModules for new code."
    },
    {
      "text": "For React: functional components with hooks only. Use TanStack Query for server state, Zustand for client state. Always use TypeScript strict mode. No class components."
    },
    {
      "text": "For Azure: always use Managed Identity and DefaultAzureCredential. Never hardcode secrets. Use ILogger<T> for logging. Use Application Insights for telemetry."
    },
    {
      "text": "Never use 'any' in TypeScript. Never hardcode secrets, URLs, or connection strings. Always write code that is unit-testable."
    }
  ],

  "github.copilot.chat.testGeneration.instructions": [
    {
      "text": "For .NET: use xUnit as the test framework, Moq for mocking, and FluentAssertions for assertions. Test naming format: MethodName_Scenario_ExpectedBehavior. Arrange-Act-Assert structure."
    },
    {
      "text": "For Angular: use Angular Testing Library with Jest. Test user interactions, not component internals. Use MockProvider for dependencies."
    },
    {
      "text": "For React: use Jest and React Testing Library. Mock APIs with msw (Mock Service Worker). Test behavior, not implementation."
    },
    {
      "text": "Always write at least one happy path test, one edge case, and one failure/error case per feature."
    }
  ],

  "github.copilot.chat.reviewSelection.instructions": [
    {
      "text": "Check for: hardcoded secrets or connection strings, missing async/await, no input validation, any usage in TypeScript, synchronous HTTP calls, methods over 40 lines, missing error handling, and violation of SOLID principles."
    },
    {
      "text": "For .NET: verify using statements are scoped, EF queries use AsNoTracking where appropriate, and controllers do not contain business logic."
    },
    {
      "text": "For TypeScript/Angular/React: check for prop drilling over 2 levels, OnPush missing from Angular components, and missing takeUntilDestroyed() on subscriptions."
    }
  ],

  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format: feat:, fix:, refactor:, test:, docs:, chore:. Keep the subject line under 72 characters. Add a blank line and body if the change needs explanation."
    }
  ],

  // ─── C# / .NET SETTINGS ────────────────────────────────────────

  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "off",
    "editor.rulers": [120]
  },

  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
  "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
  "csharp.semanticHighlighting.enabled": true,

  // ─── TYPESCRIPT / ANGULAR SETTINGS ─────────────────────────────

  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [100]
  },

  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  // Angular Language Service
  "angular.enable-strict-mode-prompt": false,
  "angular.log": "off",

  // TypeScript strict hints
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ─── REACT / JSX SETTINGS ──────────────────────────────────────

  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.rulers": [100]
  },

  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  // Emmet JSX support for React files
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.triggerExpansionOnTab": true,

  // ─── JSON / AZURE / BICEP SETTINGS ─────────────────────────────

  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  "[yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },

  "[bicep]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[dockerfile]": {
    "editor.formatOnSave": false
  },

  // ─── EDITOR EXPERIENCE ─────────────────────────────────────────

  // Bracket pair colorization (helps with deeply nested .NET LINQ / RxJS)
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  // IntelliSense
  "editor.suggest.showMethods": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showConstructors": true,
  "editor.suggest.showInterfaces": true,
  "editor.suggest.preview": true,
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "onHover",

  // Minimap
  "editor.minimap.enabled": false,

  // Sticky scroll (see which class/function you're inside)
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,

  // Smooth scrolling and cursor
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",

  // Word wrap for markdown only
  "editor.wordWrap": "off",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },

  // ─── FILE EXPLORER ─────────────────────────────────────────────

  // Hide noise from explorer
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/.angular": true,
    "**/.next": true,
    "**/dist": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },

  // Watch exclusions for performance
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.angular/**": true,
    "**/dist/**": true
  },

  // Search exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/.angular": true,
    "**/dist": true,
    "**/coverage": true,
    "**/*.min.js": true
  },

  // Trim trailing whitespace on save
  "files.trimTrailingWhitespace": true,

  // Ensure files end with a newline
  "files.insertFinalNewline": true,

  // Auto-save on focus change
  "files.autoSave": "onFocusChange",

  // ─── GIT & SOURCE CONTROL ──────────────────────────────────────

  // Enable Copilot commit message generation
  "git.branchProtection": [],
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "none",
  "scm.alwaysShowRepositories": true,

  // ─── TERMINAL ──────────────────────────────────────────────────

  // Copilot inline chat in terminal
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.persistentSessionScrollback": 1000,

  // ─── EXTENSIONS BEHAVIOR ───────────────────────────────────────

  // ESLint
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html"
  ],
  "eslint.run": "onSave",

  // Prettier
  "prettier.requireConfig": true,

  // Error Lens (highlights errors inline — recommended extension)
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.followCursor": "allLines"

  // ─── RECOMMENDED EXTENSIONS ────────────────────────────────────
  // Add this section to .vscode/extensions.json in your repo
  // "recommendations": [
  //   "github.copilot",
